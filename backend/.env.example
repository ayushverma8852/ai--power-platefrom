# =============================================================================
# InterviewPrep AI Backend Environment Variables
# =============================================================================

# Server Port
PORT=8080

# Database Configuration (MySQL 8+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=interviewprep_ai
DB_USER=interview_user
DB_PASSWORD=your_secure_db_password_here

# JWT Authentication
JWT_SECRET=your_256_bit_secret_key_at_least_32_characters_long_here
JWT_EXPIRATION_MS=86400000

# Python AI Service URL
AI_SERVICE_URL=http://localhost:8000
