# =============================================================================
# InterviewPrep AI - Comprehensive Environment Configuration Template
# Copy this file to .env and configure all variables before running docker-compose
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (MySQL 8+)
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=your_strong_mysql_root_password
DB_NAME=interviewprep_ai
DB_USER=interview_user
DB_PASSWORD=your_secure_db_user_password
DB_HOST=mysql
DB_PORT=3306
DB_PORT_FORWARD=3306

# -----------------------------------------------------------------------------
# JWT Security (Must be at least 256 bits / 32 characters in length)
# -----------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_256_bit_secret_key_at_least_32_chars
JWT_EXPIRATION_MS=86400000

# -----------------------------------------------------------------------------
# Python FastAPI AI Microservice Configuration
# -----------------------------------------------------------------------------
AI_PROVIDER=mock
DEMO_MODE=true
# Optional: Set GEMINI_API_KEY if AI_PROVIDER="gemini"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_SERVICE_URL=http://ai-service:8000
AI_CORS_ORIGINS=http://localhost:8080,http://backend:8080

# -----------------------------------------------------------------------------
# Spring Boot Backend & CORS
# -----------------------------------------------------------------------------
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://localhost

# -----------------------------------------------------------------------------
# Frontend Application
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
